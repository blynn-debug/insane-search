.env
.env.local
.omc/

# --- Secrets / credentials (never commit) ---
**/cookies.txt
**/cookies.json
**/*.expiry.json
**/token.js
**/captured.txt
._*
**/__MACOSX/

# Node
**/node_modules/

# Excel temp lock files
~$*

# Scratch working dir (session cookies, API keys, scraped dumps — never commit)
scratchpad/

# GitHub 100MB/file hard limit — source PDFs kept local only
lecture_reference/src/*.pdf
_auto_cookies.json
# Runtime observation logs
observations/

# Generated scraper-forge recon dumps — only curated recipe.yaml is tracked
recipes/*/miner-report.json
recipes/*/network.json
